#!/bin/sh
# Starts all of Rejea on this machine: the database, the file store and the
# service in Docker, and the parser on the machine itself. With an address
# in REJEA_PARSER_URL, the parser is on another machine, and this one starts
# none.
#
# Before it starts a thing, it examines the machine and names each thing
# that is missing or wrong, with its correction.
set -eu
cd "$(dirname "$0")/.."
. scripts/ui.sh

started="$(date +%s)"
mac_with_gpu=false
if [ "$(uname -s)-$(uname -m)" = "Darwin-arm64" ]; then
	mac_with_gpu=true
fi
python="${REJEA_PARSER_PYTHON:-python3.12}"
parser_installed=false
if scripts/parser has packages; then
	parser_installed=true
fi
# own_parser tells that this machine runs the parser itself.
parser_url="${REJEA_PARSER_URL:-}"
own_parser=false
if [ "$mac_with_gpu" = true ] && [ -z "$parser_url" ]; then
	own_parser=true
fi

ui_banner

# What this run downloads, so that a long first run is no surprise.
installs=""
for image in $(docker compose config --images 2>/dev/null || echo none); do
	if ! docker image inspect "$image" >/dev/null 2>&1; then
		installs="
    $ui_dot container images     ${ui_dim}0.8 GB to download${ui_reset}"
	fi
done
if [ "$own_parser" = true ]; then
	if [ "$parser_installed" = false ]; then
		installs="$installs
    $ui_dot parser packages      ${ui_dim}2.2 GB on the disk${ui_reset}"
	fi
	if ! scripts/parser has model; then
		installs="$installs
    $ui_dot parser models        ${ui_dim}2.0 GB to download${ui_reset}"
	fi
fi
echo
if [ -n "$installs" ]; then
	echo "  ${ui_bold}This run installs:${ui_reset}$installs"
	ui_note "The time is that of the downloads: 5 to 20 minutes. A later start takes 30 seconds."
else
	ui_note "All parts are on this machine. Nothing to download."
fi

# ---------------------------------------------------------------- step 1
ui_step 1 4 "Examine this machine"

# The faults, all at one time, after the things that are correct: the end
# of the output is where a person looks first.
faults=0
fault_text=""
fault() {
	faults=$((faults + 1))
	fault_text="$fault_text$(ui_fault "$1" "$2" 2>&1)
"
}

# port_free <port> <its setting> <the part that needs it>
port_free() {
	case "$1" in
	"" | *[!0-9]*)
		ports_ok=false
		fault "$2 is \"$1\". It must be a port number, such as 8080." "correct $2 in .env."
		return 0
		;;
	esac
	command -v nc >/dev/null 2>&1 || return 0
	nc -z 127.0.0.1 "$1" >/dev/null 2>&1 || return 0
	user=""
	if command -v lsof >/dev/null 2>&1; then
		user="$(lsof +c 0 -nP -iTCP:"$1" -sTCP:LISTEN 2>/dev/null | awk 'NR == 2 { print " by the program " $1 " (process " $2 ")" }')"
	fi
	ports_ok=false
	fault "Port $1 of this machine is in use$user. $3 needs it." \
		"stop that program, or set ${ui_cyan}$2${ui_reset} in .env to a free port."
}

passed=""
pass() { passed="$passed|$1"; }

docker_ready=false
if ! command -v docker >/dev/null 2>&1; then
	fault "Docker is not installed." "install it: https://docs.docker.com/get-started/get-docker/"
elif ! docker info >/dev/null 2>&1; then
	fault "Docker is installed, but it does not run." "start Docker, then run this command again."
elif ! docker compose version >/dev/null 2>&1; then
	fault "Docker Compose is not installed." "install it: https://docs.docker.com/compose/install/"
else
	docker_ready=true
	pass "Docker $(docker version --format '{{.Server.Version}}' 2>/dev/null)"
fi

# A port is examined only when Rejea itself does not have it already.
ports_ok=true
if [ "$docker_ready" = true ]; then
	running="$(docker compose ps --status running --services 2>/dev/null || true)"
	case "$running" in *rejea*) ;; *) port_free "${REJEA_PORT:-8080}" REJEA_PORT "The service" ;; esac
	case "$running" in *postgres*) ;; *) port_free "${REJEA_DB_PORT:-5433}" REJEA_DB_PORT "The database" ;; esac
	case "$running" in *storage*) ;; *) port_free "${REJEA_STORAGE_PORT:-8333}" REJEA_STORAGE_PORT "The file store" ;; esac
fi

# The service is in a container: there, an address of the machine itself
# is the container, where no parser runs.
case "$parser_url" in
*://127.* | *://0.0.0.0* | *://localhost[:/]* | *://localhost | *://\[::1\]*)
	fault "REJEA_PARSER_URL is \"$parser_url\". The service runs in a container, and it cannot get to this machine with that address." \
		"remove the value of ${ui_cyan}REJEA_PARSER_URL${ui_reset} in .env to use the parser of this machine, or give the address of a parser on another machine."
	;;
esac

if [ "$own_parser" = true ]; then
	if ! scripts/parser status; then
		port_free "${REJEA_PARSER_PORT:-8112}" REJEA_PARSER_PORT "The parser"
		port_free "${REJEA_PARSER_VLM_PORT:-8111}" REJEA_PARSER_VLM_PORT "The vision model of the parser"
	fi
	if [ "$parser_installed" = true ]; then
		pass "parser packages"
	elif ! command -v "$python" >/dev/null 2>&1; then
		fault "Python 3.12 is not installed ($python is not a command). The parser needs it." \
			"install it (brew install python@3.12), or set ${ui_cyan}REJEA_PARSER_PYTHON${ui_reset} in .env to a Python 3.12 of this machine."
	elif ! "$python" -c 'import sys; raise SystemExit(sys.version_info[:2] != (3, 12))' 2>/dev/null; then
		fault "$python is $("$python" --version 2>&1). The parser needs Python 3.12." \
			"set ${ui_cyan}REJEA_PARSER_PYTHON${ui_reset} in .env to a Python 3.12 of this machine (brew install python@3.12)."
	else
		pass "$("$python" --version 2>&1)"
	fi
fi
if [ "$docker_ready" = true ] && [ "$ports_ok" = true ]; then
	pass "ports free"
fi

# The first run downloads the images, and on a Mac the parser and its
# models.
needed_gb=3
if [ "$own_parser" = true ] && [ "$parser_installed" = false ]; then
	needed_gb=8
fi
free_gb=$(($(df -Pk . | awk 'NR == 2 { print $4 }') / 1024 / 1024))
if [ "$free_gb" -lt "$needed_gb" ]; then
	fault "The disk has $free_gb GB free. Rejea needs about $needed_gb GB." "make space on the disk, then run this command again."
else
	pass "$free_gb GB of disk"
fi

if [ "$faults" -eq 0 ] && ! docker compose config --quiet 2>/dev/null; then
	fault "Compose cannot read compose.yaml with the values of .env: $(docker compose config --quiet 2>&1 | tail -n 1)" \
		"correct the value in .env. The form of each value is in .env.example."
fi

if [ -n "$passed" ]; then
	(
		IFS="|"
		# shellcheck disable=SC2086 # Each part between the bars is one text.
		set -- ${passed#|}
		ui_ok "$@"
	)
fi
if [ "$faults" -gt 0 ]; then
	printf '%s' "$fault_text" >&2
	echo >&2
	echo "  ${ui_red}${ui_bold}Rejea cannot start:${ui_reset} $faults to correct." >&2
	exit 1
fi

# report tells which container did not start, with the end of its log: the
# log has the reason.
report() {
	echo >&2
	docker compose ps --all --format '{{.Service}} {{.State}} {{.ExitCode}} {{.Health}}' | while read -r service state code health; do
		case "$state $code $health" in
		"exited 0"* | "created "* | "running "*" healthy" | "running "*" starting") continue ;;
		esac
		echo "  ${ui_red}${ui_no}${ui_reset} The container \"$service\" is $state${health:+ and $health}. The end of its log:" >&2
		docker compose logs --no-log-prefix --tail 8 "$service" 2>&1 | sed 's/^/      /' >&2
	done
	echo "    ${ui_bold}To correct:${ui_reset} read the reason above, correct it, then run this command again." >&2
	echo "    ${ui_dim}All of a log: docker compose logs <container>${ui_reset}" >&2
	echo >&2
	echo "  ${ui_red}${ui_bold}Rejea cannot start.${ui_reset}" >&2
	exit 1
}

# ---------------------------------------------------------------- step 2
# The service starts last: the parser then answers when the service asks
# for it.
ui_step 2 4 "Database and file store"
docker compose build || report
docker compose up --detach --wait postgres storage || report
ui_step_done "images" "database" "file store"

# ---------------------------------------------------------------- step 3
ui_step 3 4 "Parser"
if [ "$own_parser" = true ]; then
	scripts/parser start
	ui_step_done "parser"
elif [ -n "$parser_url" ]; then
	# The parser is on another machine: this machine starts none.
	if curl --silent --fail --max-time 5 --output /dev/null "${parser_url%/}/health"; then
		ui_step_done "parser at $parser_url"
	else
		ui_warn "The parser at $parser_url does not answer. A PDF waits until it does."
		ui_note "To correct: start that parser, or correct REJEA_PARSER_URL in .env, then run this command again."
	fi
else
	ui_warn "This machine gets no parser: the parser runs on a Mac with Apple Silicon only."
	ui_note "A Word file needs no parser. A PDF waits until a parser answers at REJEA_PARSER_URL."
fi

# ---------------------------------------------------------------- step 4
ui_step 4 4 "Service"
docker compose up --detach --wait || report
ui_step_done "migrations" "service"
# The address of the provider cloudflare has the account ID: it has no default.
if [ -z "${REJEA_EMBED_API_KEY:-}" ] || { [ "${REJEA_EMBED_PROVIDER:-cloudflare}" = cloudflare ] && [ -z "${REJEA_EMBED_API_URL:-}" ]; }; then
	ui_warn "No embedding model is set: a document is parsed, and its index work fails until one is set."
	ui_note "To correct: set REJEA_EMBED_API_KEY and REJEA_EMBED_API_URL in .env (see \"Embeddings\" in the README), then run this command again."
fi

echo
echo "  ${ui_green}${ui_bold}Rejea runs.${ui_reset}   ${ui_dim}$(ui_time $(($(date +%s) - started)))${ui_reset}"
echo
echo "  Service      ${ui_cyan}${ui_under}http://localhost:${REJEA_PORT:-8080}${ui_reset}"
echo "  File store   ${ui_cyan}${ui_under}http://localhost:${REJEA_STORAGE_PORT:-8333}${ui_reset}"
echo "  Logs         ${ui_dim}docker compose logs --follow rejea${ui_reset}"
echo "  Stop         ${ui_dim}make down${ui_reset}"
echo
