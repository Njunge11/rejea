#!/bin/sh
# Runs the parser service on this machine, in the background.
#
#   scripts/parser start    installs the parser if it is not installed,
#                           starts it, and waits until it answers
#   scripts/parser stop     stops it
#   scripts/parser status   succeeds if the parser runs or starts
#
# The parser runs on a Mac with Apple Silicon only: the vision model uses
# the GPU through MLX. Its log is parser/.run/parser.log.
set -eu
cd "$(dirname "$0")/.."

host="${REJEA_PARSER_HOST:-127.0.0.1}"
port="${REJEA_PARSER_PORT:-8112}"
python="${REJEA_PARSER_PYTHON:-python3.12}"
run="parser/.run"
pid_file="$run/parser.pid"
log="$run/parser.log"

answers() {
	curl --silent --fail --max-time 2 --output /dev/null "http://$host:$port/health"
}

running() {
	[ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null
}

case "${1:-}" in
start)
	if answers; then
		echo "parser: it runs already, at http://$host:$port"
		exit 0
	fi
	if [ ! -x parser/.venv-paddle/bin/paddlex ] || [ ! -x parser/.venv-mlx/bin/mlx_vlm.server ]; then
		if ! command -v "$python" >/dev/null 2>&1; then
			echo "parser: $python is not installed. Install Python 3.12 (brew install python@3.12), or set REJEA_PARSER_PYTHON in .env" >&2
			exit 1
		fi
		echo "parser: install, 2.2 GB. This takes some minutes."
		if ! parser/install.sh; then
			echo "parser: the install stopped. The reason is above." >&2
			echo "  To correct: if a download failed, run this command again: the install starts again." >&2
			exit 1
		fi
	fi
	if running; then
		echo "parser: it starts already. Wait until it answers."
	else
		mkdir -p "$run"
		# With nohup, the parser stays when this terminal closes.
		nohup parser/start.sh >"$log" 2>&1 &
		echo $! >"$pid_file"
		echo "parser: start. A first start downloads the models, 2.1 GB."
	fi
	waited=0
	until answers; do
		if ! running; then
			echo "parser: it stopped. The end of $log:" >&2
			tail -n 20 "$log" | sed 's/^/    /' >&2
			echo "  To correct: read the reason above, then run this command again." >&2
			rm -f "$pid_file"
			exit 1
		fi
		sleep 5
		waited=$((waited + 5))
		if [ $((waited % 30)) -eq 0 ]; then
			echo "parser: not ready after ${waited} s. Its log is $log"
		fi
	done
	echo "parser: ready, at http://$host:$port"
	;;
status)
	answers || running
	;;
stop)
	if running; then
		kill "$(cat "$pid_file")"
		echo "parser: stopped"
	fi
	rm -f "$pid_file"
	;;
*)
	echo "usage: scripts/parser start | stop | status" >&2
	exit 1
	;;
esac
