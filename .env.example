# Copy this file to .env. The values match compose.yaml.

# The PostgreSQL database of the service.
DATABASE_URL=postgres://rejea:rejea@127.0.0.1:5433/rejea

# The address that the HTTP server listens on.
REJEA_HTTP_ADDR=127.0.0.1:8080

# The lowest level that the service logs: debug, info, warn or error.
REJEA_LOG_LEVEL=info

# The format of a log line: text or json.
REJEA_LOG_FORMAT=text

# The number of jobs that each queue runs at the same time.
REJEA_FILE_WORKERS=1
REJEA_PARSE_WORKERS=1
REJEA_INDEX_WORKERS=1

# The longest time that one attempt of a job can run.
REJEA_JOB_TIMEOUT=60m

# The number of times that a job runs before it fails with no new attempt.
REJEA_JOB_MAX_ATTEMPTS=8

# The S3 bucket of the files and its AWS Region. See "File storage" in the
# README.
REJEA_S3_BUCKET=
REJEA_S3_REGION=

# The AWS profile that gives the credentials of the service. The AWS SDK
# reads this variable. Remove it where the machine has an IAM role.
AWS_PROFILE=rejea

# The time for which an upload URL can start an upload. The AWS credentials
# must live longer than this time.
REJEA_UPLOAD_URL_LIFE=1h

# The limits of a request for upload URLs: the number of files in one
# request and the size of one file in bytes. S3 takes 5 GB at most in one
# upload request.
REJEA_MAX_UPLOAD_FILES=100
REJEA_MAX_FILE_BYTES=1073741824

# The list of documents: the number of documents in one page when the
# client gives no limit, and the largest limit that a client can give.
REJEA_LIST_LIMIT=50
REJEA_MAX_LIST_LIMIT=1000

# The largest JSON body of a request, in bytes.
REJEA_MAX_REQUEST_BYTES=1048576

# The time limits of the HTTP server: to read the request headers, to read
# the full request, to write the response, and to wait for the next request
# on a kept connection.
REJEA_HTTP_READ_HEADER_TIMEOUT=10s
REJEA_HTTP_READ_TIMEOUT=30s
REJEA_HTTP_WRITE_TIMEOUT=30s
REJEA_HTTP_IDLE_TIMEOUT=5m

# The time that open requests get to finish when the service stops.
REJEA_SHUTDOWN_TIMEOUT=10s

# The time that the database gets to answer the health check.
REJEA_HEALTH_TIMEOUT=2s

# The time that the jobs in work get to finish when the service stops. After
# it, the jobs are cancelled and run again at the next start.
REJEA_JOB_STOP_TIMEOUT=10s

# The longest time that a connection to S3 can be silent before a read
# fails. Each byte that arrives starts the time again.
REJEA_S3_READ_TIMEOUT=1m

# The time that the database gets to save the failure of a document.
REJEA_FAILURE_SAVE_TIMEOUT=10s

# The limits of one archive (zip, tar, tar.gz): the number of PDF and Word
# files in it, the size of its content when unpacked, and the size of the
# list of the files in a zip. The service keeps that list in memory.
REJEA_MAX_ARCHIVE_FILES=1000
REJEA_MAX_UNPACKED_BYTES=1000000000
REJEA_MAX_ARCHIVE_LIST_BYTES=16777216

# The size of one piece when the service reads a zip from S3 in pieces. The
# service keeps two pieces in memory for each zip in work.
REJEA_S3_RANGE_BYTES=8388608

# A document whose upload no client confirms fails after this time, and its
# file is removed. It must be longer than REJEA_UPLOAD_URL_LIFE. The second
# setting is the time between two looks for such documents.
REJEA_UPLOAD_MAX_AGE=24h
REJEA_UPLOAD_CHECK_INTERVAL=1h

# The image of a PDF page: its resolution in pixels for each inch, and the
# largest number of pixels in one image. A page that is larger gets a lower
# resolution. One pixel uses 4 bytes of memory during the render.
REJEA_PAGE_DPI=216
REJEA_MAX_PAGE_PIXELS=100000000

# The parser service (make parser). The parse API listens on the host and
# the port. The MLX server, which only the parse API uses, has its own port
# on this machine. The Python is the one that makes the environments.
REJEA_PARSER_HOST=127.0.0.1
REJEA_PARSER_PORT=8112
REJEA_PARSER_VLM_PORT=8111
REJEA_PARSER_PYTHON=python3.12

# How the service calls the parser: the address of the parse API, the
# longest time for one page, and the largest answer in bytes. With the last
# setting, the parser reads the values of each chart, which takes some
# seconds more for a page with a chart: true or false.
REJEA_PARSER_URL=http://127.0.0.1:8112
REJEA_PARSER_TIMEOUT=5m
REJEA_PARSER_MAX_ANSWER_BYTES=16777216
REJEA_PARSER_READ_CHARTS=true
