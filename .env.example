# The settings of Rejea, each with its default.
#
# "make up" needs no .env file. Copy this file to .env to change a value,
# or to run the service on the machine itself (make serve). In the
# containers of "make up", the addresses and the paths below are those of
# compose.yaml, not those of this file.

# The longest wait for the answer of the file store and of the parser when
# the service starts.
REJEA_START_CHECK_TIMEOUT=10s

# The ports of this machine that "make up" uses: the service, the database
# and the file store. Change one when another program has it.
REJEA_PORT=8080
REJEA_DB_PORT=5433
REJEA_STORAGE_PORT=8333

# The PostgreSQL database of the service.
DATABASE_URL=postgres://rejea:rejea@127.0.0.1:5433/rejea

# The address that the HTTP server listens on.
REJEA_HTTP_ADDR=127.0.0.1:8080

# The lowest level that the service logs: debug, info, warn or error.
REJEA_LOG_LEVEL=info

# The format of a log line: text or json.
REJEA_LOG_FORMAT=text

# The number of jobs that each queue runs at the same time.
REJEA_FILE_WORKERS=1
REJEA_PARSE_WORKERS=1
REJEA_INDEX_WORKERS=1

# The longest time that one attempt of a job can run.
REJEA_JOB_TIMEOUT=60m

# The number of times that a job runs before it fails with no new attempt.
REJEA_JOB_MAX_ATTEMPTS=8

# The files. These values are for the file store of compose.yaml, which
# has the API of S3: its bucket, its address and its two keys. The AWS SDK
# reads the two keys.
#
# For a bucket in AWS S3, see "File storage" in the README: remove the two
# endpoints and the two keys, and give the bucket and its AWS Region.
REJEA_S3_BUCKET=rejea
REJEA_S3_REGION=us-east-1
REJEA_S3_ENDPOINT=http://127.0.0.1:8333
REJEA_S3_PUBLIC_ENDPOINT=http://localhost:8333
AWS_ACCESS_KEY_ID=rejea
AWS_SECRET_ACCESS_KEY=rejea-local-only

# The two keys that the file store of compose.yaml takes when it starts.
# With other values here, give the same values to the two keys above.
REJEA_STORAGE_ACCESS_KEY=rejea
REJEA_STORAGE_SECRET_KEY=rejea-local-only

# The time for which an upload URL can start an upload. The AWS credentials
# must live longer than this time.
REJEA_UPLOAD_URL_LIFE=1h

# The time for which the URL of a page image can read the image. A viewer
# asks for the pages again after this time. A URL of the bucket lives for 7
# days at most. A URL of CloudFront has no limit.
REJEA_VIEW_URL_LIFE=1h

# The CloudFront distribution in front of an AWS S3 bucket: its domain
# name, the ID of the public key that the distribution trusts, and the path
# of the private key of that public key (an RSA key of 2,048 bits in a PEM
# file). With the three, the URL of a page image goes to CloudFront. With
# none, it goes to the bucket itself: the store of "make up" has no
# CloudFront. See "Pages of a document" in the README.
# REJEA_CLOUDFRONT_DOMAIN=
# REJEA_CLOUDFRONT_KEY_PAIR_ID=
# REJEA_CLOUDFRONT_PRIVATE_KEY_FILE=

# The limits of a request for upload URLs: the number of files in one
# request and the size of one file in bytes. S3 takes 5 GB at most in one
# upload request.
REJEA_MAX_UPLOAD_FILES=100
REJEA_MAX_FILE_BYTES=1073741824

# The list of documents: the number of documents in one page when the
# client gives no limit, and the largest limit that a client can give.
REJEA_LIST_LIMIT=50
REJEA_MAX_LIST_LIMIT=1000

# The list of the pages of a document: the number of pages in one list when
# the client gives no limit, and the largest limit that a client can give.
REJEA_PAGES_LIMIT=100
REJEA_MAX_PAGES_LIMIT=1000

# The search. The number of results when the client gives no limit, and
# the largest limit that a client can give.
REJEA_SEARCH_LIMIT=10
REJEA_SEARCH_MAX_LIMIT=50
# The number of chunks that the keyword search and the vector search each
# give to the merge. More candidates find more, and a search takes longer.
# From REJEA_SEARCH_MAX_LIMIT to 1000.
REJEA_SEARCH_CANDIDATES=50
# The constant k of reciprocal rank fusion: the score of a chunk is the
# sum of 1 / (k + rank). 60 is the value of the paper of the method.
REJEA_SEARCH_RANK_CONSTANT=60
# The largest number of characters of a question, and the largest number
# of document IDs in the filter of a search.
REJEA_SEARCH_MAX_QUERY_LENGTH=2000
REJEA_SEARCH_MAX_DOCUMENTS=1000
# The longest time of one search. Shorter than REJEA_HTTP_WRITE_TIMEOUT.
REJEA_SEARCH_TIMEOUT=20s

# The reranker: a model that reads the question together with each of the
# best chunks of the search and puts them in a better order. true uses it
# for each search. A request can also turn it on or off with its field
# "rerank". See "Reranker" in the README for its measured effect.
REJEA_RERANK=false
# The number of chunks of the merge that the reranker reads. More chunks
# cost more tokens and more time. Not more than 2 times
# REJEA_SEARCH_CANDIDATES.
REJEA_RERANK_CANDIDATES=50

# "make reindex" gives each parsed document new chunks. It puts the
# documents in the index queue in groups: the number of documents in one
# group, which is one transaction.
REJEA_REINDEX_BATCH_SIZE=500

# The largest JSON body of a request, in bytes.
REJEA_MAX_REQUEST_BYTES=1048576

# The time limits of the HTTP server: to read the request headers, to read
# the full request, to write the response, and to wait for the next request
# on a kept connection.
REJEA_HTTP_READ_HEADER_TIMEOUT=10s
REJEA_HTTP_READ_TIMEOUT=30s
REJEA_HTTP_WRITE_TIMEOUT=30s
REJEA_HTTP_IDLE_TIMEOUT=5m

# The time that open requests get to finish when the service stops.
REJEA_SHUTDOWN_TIMEOUT=10s

# The time that the database gets to answer the health check.
REJEA_HEALTH_TIMEOUT=2s

# The time that the jobs in work get to finish when the service stops. After
# it, the jobs are cancelled and run again at the next start. Docker gives
# the service 30 seconds to stop (stop_grace_period in compose.yaml): keep
# the sum of this time and REJEA_SHUTDOWN_TIMEOUT below it.
REJEA_JOB_STOP_TIMEOUT=10s

# The longest time that a connection to S3 can be silent before a read
# fails. Each byte that arrives starts the time again.
REJEA_S3_READ_TIMEOUT=1m

# The time that the database gets to save the failure of a document.
REJEA_FAILURE_SAVE_TIMEOUT=10s

# The limits of one archive (zip, tar, tar.gz): the number of PDF and Word
# files in it, the size of its content when unpacked, and the size of the
# list of the files in a zip. The service keeps that list in memory.
REJEA_MAX_ARCHIVE_FILES=1000
REJEA_MAX_UNPACKED_BYTES=1000000000
REJEA_MAX_ARCHIVE_LIST_BYTES=16777216

# The size of one piece when the service reads a zip from S3 in pieces. The
# service keeps two pieces in memory for each zip in work.
REJEA_S3_RANGE_BYTES=8388608

# A document whose upload no client confirms fails after this time, and its
# file is removed. It must be longer than REJEA_UPLOAD_URL_LIFE. The second
# setting is the time between two looks for such documents.
REJEA_UPLOAD_MAX_AGE=24h
REJEA_UPLOAD_CHECK_INTERVAL=1h

# The image of a PDF page: its resolution in pixels for each inch, and the
# largest number of pixels in one image. A page that is larger gets a lower
# resolution. One pixel uses 4 bytes of memory during the render.
REJEA_PAGE_DPI=216
REJEA_MAX_PAGE_PIXELS=100000000

# The parser service (make parser). The parse API listens on the host and
# the port. The MLX server, which only the parse API uses, has its own port
# on this machine. The Python is the one that makes the environments.
REJEA_PARSER_HOST=127.0.0.1
REJEA_PARSER_PORT=8112
REJEA_PARSER_VLM_PORT=8111
REJEA_PARSER_PYTHON=python3.12

# How the service calls the parser: the address of the parse API, the
# longest time for one page, and the largest answer in bytes. With the last
# two settings, the parser reads the values of each chart and the text in
# each picture, which takes some seconds more for such a page: true or
# false.
#
# REJEA_PARSER_NAME is the name and the version of the model in
# parser/pipeline.yaml. The service records it on each document that the
# parser reads. Change it when you change the model.
REJEA_PARSER_NAME=PaddleOCR-VL-1.6
REJEA_PARSER_URL=http://127.0.0.1:8112
REJEA_PARSER_TIMEOUT=5m
REJEA_PARSER_MAX_ANSWER_BYTES=16777216
REJEA_PARSER_READ_CHARTS=true
REJEA_PARSER_READ_IMAGE_TEXT=true

# The Word reader: the program that "make word-install" puts in bin/, and
# the longest time that it gets for one file. The program reads a copy of
# the file from REJEA_TEMP_DIR. With no value, that is the folder of the
# operating system for files of a short life.
REJEA_WORD_READER_PATH=bin/office-oxide
REJEA_WORD_READER_TIMEOUT=1m
REJEA_TEMP_DIR=

# The Markdown reader: the largest .md or .markdown file that it reads, in
# bytes. The file is in memory as a whole. A larger file fails with the
# reason.
REJEA_MARKDOWN_MAX_BYTES=16777216

# The chunks of a document: the largest number of tokens of one chunk, with
# its heading path. The limit of the embedding model is the upper limit of
# this value: 8,192 tokens for Qwen3-Embedding-0.6B on Cloudflare. The
# default comes from the search report: with the reranker, the search
# finds the same from 1,024 to 4,096 tokens, and a smaller chunk is on
# fewer pages. After a change, "make reindex" makes the chunks again.
#
# REJEA_TOKENIZER_PATH is the tokenizer file of the embedding model, which
# "make tokenizer-install" puts in models/. The service counts tokens with
# it. Change it when you change the embedding model.
REJEA_CHUNK_MAX_TOKENS=1024
REJEA_TOKENIZER_PATH=models/qwen3-embedding-0.6b/tokenizer.json

# The service uses three models: the embedding model, the reranker model
# and the chat model. Each one has three settings of the same form: the
# provider, the model and the API key (REJEA_<MODEL>_PROVIDER,
# REJEA_<MODEL>_MODEL, REJEA_<MODEL>_API_KEY). To change the provider of a
# model, change these three values. A key has no default: each developer
# has an account of their own.

# The embedding model: it turns each chunk and each search question into a
# vector. The provider is cloudflare (Cloudflare Workers AI): the key is an
# API token of the account, and Cloudflare needs the ID of the account
# also. See "Embeddings" in the README. With no values, the service starts,
# and the index work of a document fails with the correction as its reason.
REJEA_EMBED_PROVIDER=cloudflare
REJEA_EMBED_MODEL=@cf/qwen/qwen3-embedding-0.6b
REJEA_EMBED_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# The number of dimensions of a vector of the model. The column
# chunks.embedding has 1,024 dimensions: a model with a different number
# also needs a migration, and each chunk needs a new embedding.
REJEA_EMBED_DIMENSIONS=1024

# One request to the model: the largest number of texts and of tokens in
# it, and its longest time with its new attempts. Cloudflare takes 32 texts
# at most. It publishes no limit for the tokens: when it refuses a request
# as too large, the service sends the two halves.
REJEA_EMBED_BATCH_SIZE=32
REJEA_EMBED_BATCH_TOKENS=16000
REJEA_EMBED_TIMEOUT=2m

# The task of a search question, in one sentence. The model gets it with
# each question, and not with a chunk.
REJEA_EMBED_QUERY_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query

# The reranker model: it puts the results of a search in a better order.
# The provider is bedrock, cloudflare or cohere. See "Reranker" in the
# README.
#   cloudflare: the key is the API token of REJEA_EMBED_API_KEY, and the
#               provider uses CLOUDFLARE_ACCOUNT_ID.
#   cohere:     the key is an API key from dashboard.cohere.com/api-keys.
#               A trial key is free.
#   bedrock:    the key is an Amazon Bedrock API key of your AWS account,
#               and REJEA_BEDROCK_API_URL has the AWS Region of the model.
# With no key, the service starts, and a search that asks for the reranker
# answers with the correction.
REJEA_RERANK_PROVIDER=cloudflare
# The name that the provider gives the model. With no value, the model is
# @cf/baai/bge-reranker-base for cloudflare, rerank-v5.0-fast for cohere and
# cohere.rerank-v3-5:0 for bedrock.
# REJEA_RERANK_MODEL=
REJEA_RERANK_API_KEY=
# The longest time of one request with its new attempts.
REJEA_RERANK_TIMEOUT=10s
# The largest number of tokens of one chunk that a Cohere model reads. It
# cuts a longer chunk. Cohere counts tokens in its own way: keep this value
# at 2 times REJEA_CHUNK_MAX_TOKENS or more.
REJEA_COHERE_MAX_TEXT_TOKENS=8192

# The chat model: it reads instructions and a question, and writes an
# answer. The provider is anthropic: the key is an API key from
# platform.claude.com/settings/keys. See "Chat model" in the README. With no
# key, the service starts with no chat model.
REJEA_CHAT_PROVIDER=anthropic
# The name that the provider gives the model. With no value, the model is
# claude-sonnet-5-5 for anthropic.
# REJEA_CHAT_MODEL=
REJEA_CHAT_API_KEY=
# The largest number of tokens of one answer, and the longest time of one
# request with its new attempts.
REJEA_CHAT_MAX_ANSWER_TOKENS=16000
REJEA_CHAT_TIMEOUT=5m

# A request to a model provider: the number of attempts, and the shortest
# and the longest wait before a new attempt. A new attempt is for a request
# with no answer, for status 429 and for a status from 500.
REJEA_MODEL_MAX_ATTEMPTS=3
REJEA_MODEL_RETRY_WAIT_MIN=1s
REJEA_MODEL_RETRY_WAIT_MAX=30s

# The largest answer of the embedding model or the reranker model that the
# service reads, in bytes, and the address of the API of each provider. The
# address of Bedrock has the AWS Region: the model must be available there,
# and the API key must be of that Region or a long-term key.
REJEA_MODEL_MAX_ANSWER_BYTES=16777216
REJEA_CLOUDFLARE_API_URL=https://api.cloudflare.com/client/v4
REJEA_COHERE_API_URL=https://api.cohere.com
REJEA_ANTHROPIC_API_URL=https://api.anthropic.com
REJEA_BEDROCK_API_URL=https://bedrock-runtime.us-east-1.amazonaws.com
