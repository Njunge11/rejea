# The settings of Rejea. Copy this file to .env.
# A line "# NAME=value" shows a default. To change it, remove the "# ".

# === 1. Models ===========================================================
# Each model has 4 settings: provider, model, API key, API address.
# With no value, the model and the address are those of the provider.

# Embedding model: makes the vector of each chunk and each question.
# Provider: cloudflare. Its address has no default, because it has your
# account ID: https://api.cloudflare.com/client/v4/accounts/<account ID>/ai/run
REJEA_EMBED_PROVIDER=cloudflare
REJEA_EMBED_MODEL=
REJEA_EMBED_API_KEY=
REJEA_EMBED_API_URL=

# Reranker: puts the results of a search in a better order. Optional.
# Provider: bedrock, cloudflare or cohere.
REJEA_RERANK_PROVIDER=cloudflare
REJEA_RERANK_MODEL=
REJEA_RERANK_API_KEY=
REJEA_RERANK_API_URL=
# true: each search uses the reranker. false: only a request with "rerank": true.
REJEA_RERANK=false

# Chat model. Optional: no feature of the service uses it now.
# Provider: anthropic.
REJEA_CHAT_PROVIDER=anthropic
REJEA_CHAT_MODEL=
REJEA_CHAT_API_KEY=
REJEA_CHAT_API_URL=

# === 2. Parser (reads the pages of a PDF) ================================
# No value: the parser of this Mac. An address: a parser on another machine.
REJEA_PARSER_URL=

# === 3. "make up": ports of this machine =================================
# The service, the database, the file store.
# REJEA_PORT=8080
# REJEA_DB_PORT=5433
# REJEA_STORAGE_PORT=8333
# The parser of this Mac and its vision model.
# REJEA_PARSER_PORT=8112
# REJEA_PARSER_VLM_PORT=8111
# The keys of the file store of "make up".
# REJEA_STORAGE_ACCESS_KEY=rejea
# REJEA_STORAGE_SECRET_KEY=rejea-local-only

# === 4. "make serve" only (the service outside Docker) ===================
# "make up" does not read this section: compose.yaml gives these values.
DATABASE_URL=postgres://rejea:rejea@127.0.0.1:5433/rejea
# REJEA_HTTP_ADDR=127.0.0.1:8080

# The file store of "make db-up". The two keys are those of section 3.
# For a bucket in AWS S3: remove the two endpoints and the two keys, and
# give the bucket and its Region. See "File storage" in the README.
REJEA_S3_BUCKET=rejea
REJEA_S3_REGION=us-east-1
REJEA_S3_ENDPOINT=http://127.0.0.1:8333
REJEA_S3_PUBLIC_ENDPOINT=http://localhost:8333
AWS_ACCESS_KEY_ID=rejea
AWS_SECRET_ACCESS_KEY=rejea-local-only

# CloudFront in front of a bucket in AWS S3: all three, or none.
# See "Pages of a document" in the README.
# REJEA_CLOUDFRONT_DOMAIN=
# REJEA_CLOUDFRONT_KEY_PAIR_ID=
# REJEA_CLOUDFRONT_PRIVATE_KEY_FILE=

# Files that "make word-install" and "make tokenizer-install" put here.
# REJEA_WORD_READER_PATH=bin/office-oxide
# REJEA_TOKENIZER_PATH=models/qwen3-embedding-0.6b/tokenizer.json
# The folder for copies of Word files. No value: that of the operating system.
# REJEA_TEMP_DIR=
# REJEA_PARSER_HOST=127.0.0.1
# REJEA_PARSER_PYTHON=python3.12

# === 5. Speed ============================================================
# Jobs at the same time: file (download, hash, unpack), parse (PDF pages),
# index (chunks and vectors).
# REJEA_FILE_WORKERS=1
# REJEA_PARSE_WORKERS=1
# REJEA_INDEX_WORKERS=1

# === 6. Logs =============================================================
# debug, info, warn or error.
# REJEA_LOG_LEVEL=info
# text or json.
# REJEA_LOG_FORMAT=text

# === 7. Limits ===========================================================
# The defaults are correct for most uses.

# --- Upload ---
# Files in one request for upload URLs.
# REJEA_MAX_UPLOAD_FILES=100
# S3 takes 5 GB at most.
# REJEA_MAX_FILE_BYTES=1073741824
# The time in which an upload URL can start an upload.
# REJEA_UPLOAD_URL_LIFE=1h
# An upload that no client confirms fails after this time. Longer than
# REJEA_UPLOAD_URL_LIFE.
# REJEA_UPLOAD_MAX_AGE=24h
# REJEA_UPLOAD_CHECK_INTERVAL=1h

# --- Archives (zip, tar, tar.gz) ---
# Documents in one archive.
# REJEA_MAX_ARCHIVE_FILES=1000
# REJEA_MAX_UNPACKED_BYTES=1000000000
# The list of the files in a zip. The service keeps it in memory.
# REJEA_MAX_ARCHIVE_LIST_BYTES=16777216
# One piece of a zip that the service reads from the file store.
# REJEA_S3_RANGE_BYTES=8388608

# --- Lists of documents and of pages ---
# The default "limit" of a request, and the largest.
# REJEA_LIST_LIMIT=50
# REJEA_MAX_LIST_LIMIT=1000
# REJEA_PAGES_LIMIT=100
# REJEA_MAX_PAGES_LIMIT=1000
# The time in which the URL of a page image works. With no CloudFront: 7
# days at most.
# REJEA_VIEW_URL_LIFE=1h

# --- Search ---
# The default "limit" of a request, and the largest.
# REJEA_SEARCH_LIMIT=10
# REJEA_SEARCH_MAX_LIMIT=50
# Chunks that the keyword search and the vector search each give to the
# merge. From REJEA_SEARCH_MAX_LIMIT to 1000.
# REJEA_SEARCH_CANDIDATES=50
# The constant k of reciprocal rank fusion.
# REJEA_SEARCH_RANK_CONSTANT=60
# Characters in one question.
# REJEA_SEARCH_MAX_QUERY_LENGTH=2000
# Document IDs in one filter.
# REJEA_SEARCH_MAX_DOCUMENTS=1000
# Shorter than REJEA_HTTP_WRITE_TIMEOUT.
# REJEA_SEARCH_TIMEOUT=20s

# --- Reranker ---
# Chunks that the reranker reads. 2 times REJEA_SEARCH_CANDIDATES at most.
# REJEA_RERANK_CANDIDATES=50
# REJEA_RERANK_TIMEOUT=10s
# Tokens of one chunk that the model reads. Only the provider cohere uses
# this limit.
# REJEA_RERANK_MAX_TEXT_TOKENS=8192

# --- Chunks ---
# Tokens in one chunk. After a change: make reindex.
# REJEA_CHUNK_MAX_TOKENS=1024
# Documents in one group of "make reindex".
# REJEA_REINDEX_BATCH_SIZE=500

# --- Embedding model ---
# The dimensions of a vector of the model. A different number needs a
# migration of the column chunks.embedding.
# REJEA_EMBED_DIMENSIONS=1024
# Texts and tokens in one request.
# REJEA_EMBED_BATCH_SIZE=32
# REJEA_EMBED_BATCH_TOKENS=16000
# REJEA_EMBED_TIMEOUT=2m
# The instruction that the model gets with each question.
# REJEA_EMBED_QUERY_INSTRUCTION=Given a web search query, retrieve relevant passages that answer the query

# --- Chat model ---
# REJEA_CHAT_MAX_ANSWER_TOKENS=16000
# REJEA_CHAT_TIMEOUT=5m

# --- Requests to a model provider ---
# Attempts for one request, and the wait before a new attempt.
# REJEA_MODEL_MAX_ATTEMPTS=3
# REJEA_MODEL_RETRY_WAIT_MIN=1s
# REJEA_MODEL_RETRY_WAIT_MAX=30s
# REJEA_MODEL_MAX_ANSWER_BYTES=16777216

# --- PDF ---
# The resolution of a page image, and its largest size.
# REJEA_PAGE_DPI=216
# REJEA_MAX_PAGE_PIXELS=100000000
# The service records this name on each document. Change it with the model
# in parser/pipeline.yaml.
# REJEA_PARSER_NAME=PaddleOCR-VL-1.6
# The time for one page.
# REJEA_PARSER_TIMEOUT=5m
# REJEA_PARSER_MAX_ANSWER_BYTES=16777216
# true or false. true: the parser reads the values of a chart and the text
# in a picture, which takes some seconds more for such a page.
# REJEA_PARSER_READ_CHARTS=true
# REJEA_PARSER_READ_IMAGE_TEXT=true

# --- Word and Markdown ---
# REJEA_WORD_READER_TIMEOUT=1m
# REJEA_MARKDOWN_MAX_BYTES=16777216

# --- Jobs ---
# The time for one attempt, and the number of attempts.
# REJEA_JOB_TIMEOUT=60m
# REJEA_JOB_MAX_ATTEMPTS=8

# --- HTTP server ---
# REJEA_MAX_REQUEST_BYTES=1048576
# REJEA_HTTP_READ_HEADER_TIMEOUT=10s
# REJEA_HTTP_READ_TIMEOUT=30s
# REJEA_HTTP_WRITE_TIMEOUT=30s
# REJEA_HTTP_IDLE_TIMEOUT=5m

# --- Start and stop ---
# The wait for the file store and the parser when the service starts.
# REJEA_START_CHECK_TIMEOUT=10s
# REJEA_HEALTH_TIMEOUT=2s
# The time for open requests and for jobs in work when the service stops.
# Their sum: less than the 30 seconds of stop_grace_period in compose.yaml.
# REJEA_SHUTDOWN_TIMEOUT=10s
# REJEA_JOB_STOP_TIMEOUT=10s
# REJEA_FAILURE_SAVE_TIMEOUT=10s
# A connection to the file store with no data for this time fails.
# REJEA_S3_READ_TIMEOUT=1m
